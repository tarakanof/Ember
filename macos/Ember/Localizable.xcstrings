{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "comment" : "From EmberKit (not extracted automatically; kept in step by StringCatalogTests).",
      "extractionState" : "manual",
      "shouldTranslate" : false
    },
    "%@ %@" : {
      "comment" : "An SF Symbol, then a value: the usage reset icon and a time (\"↻ 16:20\"), or a duration and a session count.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ 5h %@" : {
      "comment" : "Menu usage row: tool name, then percent of its 5-hour window used (\"Claude 5h 47%\").",
      "extractionState" : "manual"
    },
    "%@ 5h %@ · resets %@" : {
      "comment" : "Menu usage row: tool name, percent used, then when the 5-hour window resets (a time, or weekday and time).",
      "extractionState" : "manual"
    },
    "%@ 5h limit reached" : {
      "comment" : "Menu usage row: tool name; its 5-hour window is used up.",
      "extractionState" : "manual"
    },
    "%@ 5h limit reached · resets %@" : {
      "comment" : "Menu usage row: tool name, then when the used-up 5-hour window resets.",
      "extractionState" : "manual"
    },
    "%@ active, ^[%lld session](inflect: true)" : {
      "comment" : "VoiceOver, Work hours chart: active time (\"5h 10m\"), then the number of focus sessions.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ active, ^[%2$lld session](inflect: true)"
          }
        }
      }
    },
    "%@ available" : {
      "comment" : "Clock health: a newer clock firmware version is available. The argument is the version (\"1.2.0\")."
    },
    "%@ context" : {
      "comment" : "Share of an agent session's context window in use (\"41% context\"). The argument is a percent.",
      "extractionState" : "manual"
    },
    "%@ in 24 h" : {
      "comment" : "Settings › Clock: share of the server's pushes that reached the clock over the last 24 hours (\"98% in 24 h\")."
    },
    "%@ left" : {
      "comment" : "VoiceOver, Focus ring: time left in the current phase (\"18:42\")."
    },
    "%@ now, %@ high" : {
      "comment" : "VoiceOver, weather forecast strip: the current temperature, then the highest over the next hours.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ now, %2$@ high"
          }
        }
      }
    },
    "%@ of focus over 7 days." : {
      "comment" : "VoiceOver chart summary: total focus time over the last 7 days (\"6h 15m\")."
    },
    "%@ on %@ — %@" : {
      "comment" : "An agent session: tool name, the Mac it runs on, then its state (\"Claude on m4 — Running\").",
      "extractionState" : "manual"
    },
    "%@ over 7 days." : {
      "comment" : "VoiceOver chart summary: total agent time over the last 7 days (\"12h 40m\")."
    },
    "%@ so far" : {
      "comment" : "12-week chart: focus time this week, which is still in progress (\"2h 30m\")."
    },
    "%@ · %@" : {
      "comment" : "Menu Other Sessions row: session title (\"Codex on m5 — Waiting\"), then context use (\"41% context\").",
      "extractionState" : "manual"
    },
    "%@ · %@ left · round %lld" : {
      "comment" : "Menu Pomodoro status: phase name, remaining time (\"18:42\"), round number.",
      "extractionState" : "manual"
    },
    "%@ · %lld dBm" : {
      "comment" : "Settings › Clock: Wi-Fi quality in words (\"Good\"), then the signal strength in dBm.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$lld dBm"
          }
        }
      }
    },
    "%@ · ^[%lld session](inflect: true)" : {
      "comment" : "Chart callout: focus time (\"1h 15m\"), then the number of focus sessions.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · ^[%2$lld session](inflect: true)"
          }
        }
      }
    },
    "%@ · firmware %@" : {
      "comment" : "Discover Clocks sheet: the clock's host name or address, then its firmware version.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · firmware %2$@"
          }
        }
      }
