<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>Ember</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSAppleEventsUsageDescription</key>
    <string>Ember reads the playing track's position and artwork from Music to show them on your Ember displays.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>Ember rings your AWTRIX clock when an Apple Reminder with a due time comes due.</string>
    <key>NSRemindersUsageDescription</key>
    <string>Ember rings your AWTRIX clock when an Apple Reminder with a due time comes due.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Ember uses your location to prefill the weather widget's coordinates.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Ember finds your Ember server and AWTRIX clock on the local network.</string>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.ember.Ember.clock-app</string>
            <key>UTTypeDescription</key>
            <string>Ember clock app</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.ember.Ember.knob-page</string>
            <key>UTTypeDescription</key>
            <string>Ember knob page</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.ember.Ember.usage-account</string>
            <key>UTTypeDescription</key>
            <string>Ember usage account</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
        </dict>
    </array>
    <key>SUFeedURL</key>
    <string>https://github.com/tarakanof/ember/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>PLACEHOLDER+REPLACE+WITH+THE+OWNERS+EDKEY+A=</string>
    <key>SUEnableAutomaticChecks</key>
    <string>$(EMBER_SPARKLE_AUTOMATIC_CHECKS)</string>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUAllowsAutomaticUpdates</key>
    <false/>
    <key>SUEnableSystemProfiling</key>
    <false/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
    <key>NSBonjourServices</key>
    <array>
        <string>_ember._tcp</string>
        <string>_awtrixng._tcp</string>
    </array>
</dict>
</plist>
