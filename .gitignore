.DS_Store
/ember
/ember-claude-producer
/ember-codex-producer
/config.json
/dist/

# Local-only agent context (deployment-specific hosts, vault path). Ships as
# AGENTS.local.md.example; the filled-in copy stays local.
/AGENTS.local.md
/CLAUDE.local.md
/.gocache/
*.log

# Xcode build products from local `xcodebuild` runs (the SwiftPM .build/ dir is
# under macos/ too; both are local-only).
/macos/build/
/macos/.build/

# Superpowers-skill artifacts (specs, plans, brainstorms) are local-only
# scaffolding and not part of the shipped repo. STYLE.md (under docs/, not
# docs/superpowers/) does ship.
/docs/superpowers/
/.superpowers/
/.claire/

# Claude Code agent worktrees
.claude/worktrees/
