# ember-claude-producer configuration
# Optional: machine label on the clock card (~4 glyphs). Empty defaults to a short
# id from this Mac's host name (e.g. mbp, mini); install writes it here.
EMBER_SOURCE=

# Empty or "auto" = find the server over mDNS (_ember._tcp); set
# http://host:3627 when several servers answer or multicast can't reach it.
EMBER_SERVER_URL=
# Required:
EMBER_TOKEN=set-me-to-the-server-bearer-token

# Optional (defaults shown):
# EMBER_HEARTBEAT_TTL_HOURS=6
# EMBER_HOOK_TIMEOUT_MS=500
# EMBER_DONE_TTL_SECONDS=30
