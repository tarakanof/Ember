# Ember CLI configuration. Copy to ~/.config/ember/cli.env and fill in.
# Values here are overridden by any EMBER_* environment variables already set.

# Base URL of your Ember server.
EMBER_URL=http://localhost:8080

# Bearer token for write endpoints (start/stop/pause/...). Leave empty only if
# the server runs in open mode. NEVER commit your real token.
EMBER_TOKEN=
